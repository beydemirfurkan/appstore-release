{
  "$schema": "https://beydemirfurkan.github.io/appstore-release/schemas/v1/config.schema.json",
  "bundleId": "com.example.app",
  "appleTeamId": "XXXXXXXXXX",
  "locale": "en-US",
  "$comment": "For more than one App Store locale, add a \"locales\" block keyed by locale code. Each entry overrides \"metadata\"; anything it omits is inherited. Example: \"locales\": { \"en-US\": {}, \"tr\": { \"name\": \"Deneme\", \"description\": \"...\" } }",
  "metadata": {
    "name": "App Name",
    "subtitle": "Subtitle, max 30 chars",
    "privacyPolicyUrl": "https://example.com/privacy",
    "supportUrl": "https://example.com/support",
    "marketingUrl": "https://example.com",
    "description": "Full description. No emoji. Use plain uppercase section headers.",
    "keywords": "keyword1,keyword2,keyword3",
    "promotionalText": "Promo text, max 170 chars",
    "copyright": "2026 Your Name"
  },
  "category": {
    "primary": "LIFESTYLE",
    "secondary": "REFERENCE"
  },
  "ageRating4Plus": true,
  "contentRights": "DOES_NOT_USE_THIRD_PARTY_CONTENT",
  "price": "free",
  "review": {
    "contactFirstName": "First",
    "contactLastName": "Last",
    "contactPhone": "+10000000000",
    "contactEmail": "you@example.com",
    "demoAccountRequired": false,
    "notes": "The app is fully usable without an account."
  },
  "screenshots": {
    "displayType": "APP_IPHONE_67",
    "dir": "./assets/screenshots"
  },
  "credentials": {
    "outputDir": "./secrets"
  },
  "subscription": {
    "productId": "app_monthly",
    "groupDisplayName": "Premium",
    "localeName": "Monthly Premium",
    "localeDescription": "Unlock all premium features.",
    "priceTerritory": "USA",
    "priceAmount": 4.99,
    "reviewScreenshot": "./assets/paywall.png"
  }
}
