{
  "name": "appstore-release",
  "version": "4.3.0",
  "description": "Ship an iOS app to App Store review end to end over the App Store Connect API — agent skills, an MCP server and a CLI around a readiness report and an idempotent pipeline. Updated for iOS 27.",
  "keywords": [
    "app-store",
    "app-store-connect",
    "ios",
    "asc",
    "submission",
    "release",
    "automation",
    "mcp",
    "mcp-server",
    "ai-agent",
    "claude",
    "expo",
    "eas"
  ],
  "homepage": "https://github.com/beydemirfurkan/appstore-release",
  "bugs": "https://github.com/beydemirfurkan/appstore-release/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beydemirfurkan/appstore-release.git"
  },
  "license": "MIT",
  "author": {
    "name": "Furkan Beydemir",
    "url": "https://github.com/beydemirfurkan"
  },
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "appstore-release": "src/cli.mjs",
    "appstore-release-mcp": "src/mcp/server.mjs"
  },
  "files": [
    "src",
    "schemas",
    "types",
    "skills",
    ".claude-plugin",
    ".mcp.json"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "types": "tsc --emitDeclarationOnly --declaration --outDir types",
    "manifests:sync": "node scripts/sync-manifests.mjs",
    "manifests:check": "node scripts/sync-manifests.mjs --check",
    "test": "node scripts/test.mjs",
    "version": "npm run manifests:sync && git add .claude-plugin skills scripts/skill-launcher.mjs",
    "prepack": "npm run manifests:check",
    "schema:validate": "node scripts/validate-schema.mjs",
    "verify": "npm run typecheck && npm run format:check && npm run schema:validate && npm run manifests:check && npm run check:dist && npm run check:skills && npm test",
    "check:dist": "node scripts/check-distribution.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "media": "node scripts/media.mjs",
    "demo:server": "node scripts/demo/server.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./schema": "./schemas/config.schema.json",
    "./package.json": "./package.json",
    "./mcp": "./src/mcp/server.mjs"
  },
  "private": true
}
